+/**
+ * @brief Append CVE/SCAP prognosis results to an existing report (same format
+ *        as standalone CVE Scanner), after a network scan has populated hosts.
+ *
+ * @param[in]  task    Task.
+ * @param[in]  report  Report to add CVE results to (usually global_current_report).
+ */
+void
+append_cve_phase_to_report (task_t task, report_t report)
+{
+  target_t target;
+  char *hosts, *exclude_hosts;
+  gvm_hosts_t *gvm_hosts;
+  gvm_host_t *gvm_host;
+  int matching_version;
+
+  assert (task);
+  assert (report);
+
+  target = task_target (task);
+  if (!target)
+    return;
+
+  hosts = target_hosts (target);
+  if (hosts == NULL)
+    return;
+
+  exclude_hosts = target_exclude_hosts (target);
+
+  gvm_hosts = gvm_hosts_new (hosts);
+  free (hosts);
+
+  if (gvm_hosts_exclude (gvm_hosts, exclude_hosts ?: "") < 0)
+    {
+      gvm_hosts_free (gvm_hosts);
+      free (exclude_hosts);
+      return;
+    }
+  free (exclude_hosts);
+
+  setting_value_int (SETTING_UUID_CVE_CPE_MATCHING_VERSION, &matching_version);
+
+  while ((gvm_host = gvm_hosts_next (gvm_hosts)))
+    if (cve_scan_host (task, report, gvm_host, matching_version))
+      {
+        g_warning ("%s: CVE phase failed for a host", __func__);
+        break;
+      }
+  gvm_hosts_free (gvm_hosts);
+}
