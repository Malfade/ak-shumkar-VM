# See Dockerfile.custom-ospd-openvas — Trixie base has no libssh-gcrypt package; copy from Bookworm.
FROM debian:bookworm-slim AS libssh-gcrypt-from-bookworm
RUN apt-get update \
  && apt-get install -y --no-install-recommends libssh-gcrypt-4 findutils \
  && mkdir -p /export \
  && find /usr/lib -maxdepth 2 -name 'libssh-gcrypt.so.4*' -exec cp -a {} /export/ \; \
  && rm -rf /var/lib/apt/lists/*

FROM registry.community.greenbone.net/community/openvas-scanner:stable
COPY --from=libssh-gcrypt-from-bookworm /export/ /usr/local/lib/
RUN ldconfig
COPY build/src/openvas /usr/local/sbin/openvas
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so.23.41.0
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so.23
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so.23.41.0
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so.23
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so
RUN ldconfig
