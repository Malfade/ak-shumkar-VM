# Greenbone openvas-scanner:stable base image may contain older/different gvm-libs than the build environment.
# Provide matching libgvm_*.so* from gvm-libs image (and libssh-gcrypt from Bookworm).
ARG GVM_LIBS_IMAGE=registry.community.greenbone.net/community/gvm-libs:stable
FROM ${GVM_LIBS_IMAGE} AS gvm-libs-provider

FROM debian:bookworm-slim AS libssh-gcrypt-from-bookworm
RUN apt-get update \
  && apt-get install -y --no-install-recommends libssh-gcrypt-4 \
  && mkdir -p /export \
  && find /usr/lib -maxdepth 2 -name 'libssh-gcrypt.so*' -exec cp -a {} /export/ \; \
  && ls -la /export/ \
  && test -e /export/libssh-gcrypt.so.4 \
  && rm -rf /var/lib/apt/lists/*

FROM registry.community.greenbone.net/community/openvas-scanner:stable
COPY --from=libssh-gcrypt-from-bookworm /export/ /usr/local/lib/
COPY --from=gvm-libs-provider /usr/local/lib/libgvm_*.so* /usr/local/lib/
RUN printf '/usr/local/lib\n' > /etc/ld.so.conf.d/zz-usr-local-lib.conf \
  && ldconfig
ENV LD_LIBRARY_PATH=/usr/local/lib
COPY build/src/openvas /usr/local/sbin/openvas
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so.23.41.0
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so.23
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so.23.41.0
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so.23
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so
RUN ldconfig \
  && test -r /usr/local/lib/libssh-gcrypt.so.4 \
  && ! (LANG=C LD_LIBRARY_PATH=/usr/local/lib ldd /usr/local/sbin/openvas 2>&1 | tee /dev/stderr | grep 'not found') \
  && /usr/local/sbin/openvas --version
