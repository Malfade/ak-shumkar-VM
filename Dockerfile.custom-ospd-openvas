FROM registry.community.greenbone.net/community/ospd-openvas:stable
RUN apt-get update \
  && apt-get install -y --no-install-recommends libssh-gcrypt4 \
  && rm -rf /var/lib/apt/lists/*
COPY build/src/openvas /usr/local/sbin/openvas
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so.23.41.0
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so.23
COPY build/nasl/libopenvas_nasl.so /usr/local/lib/libopenvas_nasl.so
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so.23.41.0
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so.23
COPY build/misc/libopenvas_misc.so /usr/local/lib/libopenvas_misc.so
RUN ldconfig
